# Copy to .env.local and edit. Both variables are optional.

# 'live' (the default) talks to the server.
# 'mock' runs the whole app against ../docs/examples/ with no backend at all.
VITE_API_MODE=live

# Only used when VITE_API_MODE=live.
#
# `npm run dev` already sets this to /api/v1 via .env.development, so requests
# go through the Vite proxy. Override it for a build, or to point at a backend
# somewhere else.
VITE_API_BASE_URL=http://localhost:8000/api/v1
