    {
      "id": "rfi",
      "name": "Raise First In",
      "description": "Decide whether to open-raise or fold when the pot is unopened.",
      "version": 1,
      "config_schema": {
        "fields": [
          {
            "key": "game",
            "label": "Game",
            "type": "enum",
            "default": "holdem",
            "options": [
              {
                "value": "holdem",
                "label": "Hold'em"
              },
              {
                "value": "plo",
                "label": "PLO (Pot Limit Omaha)"
              }
            ]
          },
          {
            "key": "table_format",
            "label": "Table format",
            "type": "enum",
            "default": "6max",
            "options": [
              {
                "value": "6max",
                "label": "6-max"
              },
              {
                "value": "8max",
                "label": "8-max (full ring)"
              }
            ]
          },
          {
            "key": "positions",
            "label": "Positions",
            "type": "multi_enum",
            "default": [
              "UTG",
              "HJ",
              "CO",
              "BTN",
              "SB"
            ],
            "options_by": {
              "6max": [
                {
                  "value": "UTG",
                  "label": "UTG"
                },
                {
                  "value": "HJ",
                  "label": "Hijack"
                },
                {
                  "value": "CO",
                  "label": "Cutoff"
                },
                {
                  "value": "BTN",
                  "label": "Button"
                },
                {
                  "value": "SB",
                  "label": "Small blind"
                }
              ],
              "8max": [
                {
                  "value": "UTG",
                  "label": "UTG"
                },
                {
                  "value": "UTG1",
                  "label": "UTG+1"
                },
                {
                  "value": "LJ",
                  "label": "Lojack"
                },
                {
                  "value": "HJ",
                  "label": "Hijack"
                },
                {
                  "value": "CO",
                  "label": "Cutoff"
                },
                {
                  "value": "BTN",
                  "label": "Button"
                },
                {
                  "value": "SB",
                  "label": "Small blind"
                }
              ]
            },
            "depends_on": "table_format"
          },
          {
            "key": "question_count",
            "label": "Hands",
            "type": "int",
            "default": 25,
            "min": 5,
            "max": 200
          },
          {
            "key": "weighting",
            "label": "Hand selection",
            "type": "enum",
            "default": "borderline",
            "options": [
              {
                "value": "uniform",
                "label": "Uniform \u2014 any dealt hand"
              },
              {
                "value": "borderline",
                "label": "Borderline \u2014 favour close decisions"
              }
            ]
          }
        ]
      }
    },
